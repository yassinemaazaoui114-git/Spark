{
  "expo": {
    "name": "Spark",
    "slug": "spark",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "spark",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1a0b2e",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.yassinemaazaoui.spark",
      "adaptiveIcon": {
        "backgroundColor": "#1a0b2e",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1a0b2e",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Spark to access your microphone to record voice notes.",
          "enableBackgroundPlayback": true
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Spark to use Face ID to unlock your notes."
        }
      ],
      "expo-asset",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Blue",
            "android": {
              "foregroundImage": "./assets/icons/icon-spark-blue-maskable-512.png",
              "backgroundColor": "#1a0b2e"
            }
          },
          {
            "name": "Emerald",
            "android": {
              "foregroundImage": "./assets/icons/icon-spark-emerald-maskable-512.png",
              "backgroundColor": "#1a0b2e"
            }
          },
          {
            "name": "Rose",
            "android": {
              "foregroundImage": "./assets/icons/icon-spark-rose-maskable-512.png",
              "backgroundColor": "#1a0b2e"
            }
          },
          {
            "name": "Amber",
            "android": {
              "foregroundImage": "./assets/icons/icon-spark-amber-maskable-512.png",
              "backgroundColor": "#1a0b2e"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "70464c82-2106-4e3a-b93e-2fcf2fbf1229"
      }
    }
  }
}
